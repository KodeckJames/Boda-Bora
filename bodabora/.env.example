# Copy to .env.local. Public values only: NEXT_PUBLIC_* ends up in the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only (never NEXT_PUBLIC_). Neon Auth for the production branch:
#   neon neon-auth status   → Base URL
NEON_AUTH_BASE_URL=
# 32+ random characters for signing the session cookie: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=
