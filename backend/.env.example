# Copy to .env and fill in. Bun loads .env automatically.
# The Neon-managed values below are written by `neon deploy` / `neon env pull` — don't fill them by hand.
PORT=4000
# Comma-separated origins allowed by CORS (the Next.js app in dev and prod)
CORS_ORIGINS=http://localhost:3000,https://boda-bora.vercel.app

# Neon (managed)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
NEON_FUNCTION_API_BASE_URL=
# Object Storage (managed, AWS-standard names)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
# AI Gateway (managed, only on a paid Neon plan)
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=

# Africa's Talking USSD / SMS
AT_USERNAME=sandbox
AT_API_KEY=
USSD_CALLBACK_TOKEN=
USSD_SERVICE_CODE=*384*22#
